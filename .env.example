DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME
PORT=8080
# Must be the public frontend origin (not the API URL), with https in production
PUBLIC_APP_URL=https://mystery-shopper-frontend1.onrender.com

# Email — choose ONE provider (Brevo HTTPS is preferred on Render Free)
#
# Option A — Brevo HTTPS API (recommended, works on Render Free where SMTP is blocked):
#   Create API key at https://app.brevo.com/settings/keys/api
#   Verify sender at https://app.brevo.com/senders (must match FROM_EMAIL)
BREVO_API_KEY=

# Option B — ZeptoMail SMTP (legacy, outbound port 465/587 blocked on Render Free → ETIMEDOUT):
ZEPTOMAIL_SMTP_HOST=smtp.zeptomail.in
ZEPTOMAIL_SMTP_PORT=587
ZEPTOMAIL_SMTP_USER=emailapikey
ZEPTOMAIL_SMTP_PASSWORD=
#
# Shared sender identity (used by both providers):
ZEPTOMAIL_FROM_EMAIL=care@ricoz.in
ZEPTOMAIL_FROM_NAME=Ricoz Innovation
ZEPTOMAIL_CONTACT_TO=care@ricoz.in

# Frontend — Vite build-time API endpoint (set on frontend Static Site, not backend)
# Must be the public backend URL; if unset the frontend falls back to relative /api (dev proxy only)
VITE_API_BASE_URL=https://mystery-shopper-api.onrender.com
